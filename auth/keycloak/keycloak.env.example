# /etc/keycloak/keycloak.env (root:keycloak, 0640). Replace every REPLACE_ value.
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://127.0.0.1:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD

# Public sign-in address (served through the Cloudflare Tunnel). The admin console is
# only reachable on the server itself, through KC_HOSTNAME_ADMIN on loopback.
KC_HOSTNAME=https://auth.example.com
KC_HOSTNAME_ADMIN=http://127.0.0.1:8180
KC_PROXY_HEADERS=xforwarded

# Plain HTTP on loopback only; cloudflared terminates TLS.
KC_HTTP_ENABLED=true
KC_HTTP_HOST=127.0.0.1
KC_HTTP_PORT=8180
KC_HTTP_MANAGEMENT_PORT=9180
KC_HEALTH_ENABLED=true

# Keycloak's default heap is a percentage of all RAM; cap it so it shares the host
# politely with the gateway and the Minecraft servers.
JAVA_OPTS_KC_HEAP=-Xms256m -Xmx768m
