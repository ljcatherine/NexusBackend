# Copy to /etc/nexus-mail/nexus-mail.env (owner root, group nexus-mail, mode 640) and fill in.

# Shared with the nexus-online Worker (wrangler secret MAIL_SERVICE_TOKEN). Generate with:
#   openssl rand -hex 32
NEXUS_MAIL_TOKEN=REPLACE_WITH_64_HEX_CHARACTERS

# Loopback only. The Cloudflare tunnel's VPC service points at this address.
NEXUS_MAIL_LISTEN=127.0.0.1:8898

# Addresses you may send from, comma separated. The first is the default.
NEXUS_MAIL_FROM=liam@liamjc.dev
NEXUS_MAIL_FROM_NAME=Liam

# Brevo: Settings -> SMTP & API -> SMTP tab. The login looks like 1234ab001@smtp-brevo.com.
NEXUS_MAIL_SMTP_HOST=smtp-relay.brevo.com
NEXUS_MAIL_SMTP_PORT=587
NEXUS_MAIL_SMTP_USER=REPLACE_WITH_BREVO_SMTP_LOGIN
NEXUS_MAIL_SMTP_PASSWORD=REPLACE_WITH_BREVO_SMTP_KEY

# Check your Cloudflare Access token on every mailbox request (needs: sudo apt install python3-cryptography).
# Team domain and the AUD tag of mail.liamjc.dev's Access application; owner = the one allowed email.
NEXUS_MAIL_ACCESS_TEAM=REPLACE_WITH_TEAM.cloudflareaccess.com
NEXUS_MAIL_ACCESS_AUD=REPLACE_WITH_MAIL_ACCESS_APPLICATION_AUD_TAG
NEXUS_MAIL_OWNER=REPLACE_WITH_OWNER_EMAIL

# Limits: refuse incoming mail when the mailbox passes this size, when the disk (shared with Keycloak)
# drops below this much free space, or when one sender sends more than this per hour.
NEXUS_MAIL_MAX_STORE_MB=5000
NEXUS_MAIL_MIN_FREE_PERCENT=10
NEXUS_MAIL_SENDER_HOURLY=60
